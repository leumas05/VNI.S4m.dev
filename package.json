{
  "name": "vni-engine",
  "version": "1.1.10",
  "description": "Visual Network Intelligence Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"electron .\"",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:app": "npm run build:frontend && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "dev.s4m.vni",
    "productName": "VNI Engine",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "leumas05",
      "repo": "VNI.S4m.dev"
    },
    "extraFiles": [
      "README.txt"
    ],
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "artifactName": "vni-engine-mac-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "vni-engine-linux-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "vni-engine-setup-${version}.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "jimp": "^0.16.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "puppeteer": "^25.12.0",
    "qrcode-terminal": "^0.12.0",
    "rcedit": "^3.0.1",
    "react-leaflet": "^5.0.0"
  },
  "pkg": {
    "assets": [
      "frontend/dist/**/*"
    ]
  }
}